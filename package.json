{
  "name": "taller-sem11-api-libros",
  "version": "1.0.0",
  "private": true,
  "description": "API REST de libros con Express, PostgreSQL y autenticacion JWT",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:init": "node scripts/init-db.js",
    "db:check": "node scripts/check-db.js",
    "test:smoke": "node scripts/smoke-test.js",
    "token:expired": "node scripts/generar-token-expirado.js"
  },
