{
  "info": {
    "name": "Taller Sem11 - API Libros JWT",
    "description": "Coleccion para probar login, CRUD protegido y validaciones de la API de libros.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "libroId",
      "value": ""
    },
    {
      "key": "usuarioDemo",
      "value": "docente"
    },
    {
      "key": "passwordDemo",
      "value": ""
    },
    {
      "key": "nuevoUsuario",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Autenticacion",
      "item": [
        {
          "name": "Login correcto",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Devuelve un JWT', () => pm.expect(json.token).to.be.a('string').and.not.empty);",
                  "pm.collectionVariables.set('token', json.token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuario\": \"{{usuarioDemo}}\",\n  \"password\": \"{{passwordDemo}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Login incorrecto",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Responde 401', () => pm.response.to.have.status(401));",
                  "pm.test('No devuelve token', () => pm.expect(pm.response.json().token).to.be.undefined);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuario\": \"{{usuarioDemo}}\",\n  \"password\": \"contrasena-incorrecta\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Registrar usuario",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.collectionVariables.set('nuevoUsuario', 'usuario_' + Date.now());"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Responde 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.test('Devuelve el usuario normalizado', () => pm.expect(json.usuario).to.eql(pm.collectionVariables.get('nuevoUsuario')));",
                  "pm.test('No devuelve el hash', () => pm.expect(json.password_hash).to.be.undefined);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuario\": \"{{nuevoUsuario}}\",\n  \"password\": \"ClaveSegura123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "02 CRUD con JWT",
      "item": [
        {
          "name": "Crear libro",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Responde 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.test('Devuelve id', () => pm.expect(json.id).to.be.a('number'));",
                  "pm.collectionVariables.set('libroId', json.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"El principito\",\n  \"autor\": \"Antoine de Saint-Exupery\",\n  \"anio\": 1943\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/libros",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "libros"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Listar libros",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Devuelve un arreglo', () => pm.expect(json).to.be.an('array'));",
                  "pm.test('Contiene el libro creado', () => {",
                  "  const id = Number(pm.collectionVariables.get('libroId'));",
                  "  pm.expect(json.some((libro) => libro.id === id)).to.eql(true);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/libros",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "libros"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Obtener libro por id",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Devuelve el libro solicitado', () => {",
                  "  pm.expect(json.id).to.eql(Number(pm.collectionVariables.get('libroId')));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/libros/{{libroId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "libros",
                "{{libroId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Actualizar libro",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Titulo actualizado', () => pm.expect(json.titulo).to.eql('El principito (edicion revisada)'));",
                  "pm.test('Anio actualizado', () => pm.expect(json.anio).to.eql(1945));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"El principito (edicion revisada)\",\n  \"anio\": 1945\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/libros/{{libroId}}",
              "host": [
                "{{baseUrl}}"
