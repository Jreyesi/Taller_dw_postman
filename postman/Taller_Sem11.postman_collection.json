              ]
            }
          },
          "response": []
        },
        {
          "name": "Eliminar libro",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('Confirma la eliminacion', () => pm.expect(pm.response.json().message).to.include('eliminado'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/libros/{{libroId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "libros",
                "{{libroId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Verificar libro eliminado (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Responde 404', () => pm.response.to.have.status(404));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
